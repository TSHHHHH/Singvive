{
  "name": "singvive",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "bake:pois": "node --experimental-strip-types scripts/bake-pois.mjs",
    "bake:mrt": "node scripts/bake-mrt.mjs",
    "bake:zones": "node --experimental-strip-types scripts/bake-zones.mjs",
    "bake:towns": "node --experimental-strip-types scripts/bake-towns.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply singvive-scores --remote",
    "db:migrate:local": "wrangler d1 migrations apply singvive-scores --local"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-leaflet": "^5.0.0",
    "react-zoom-pan-pinch": "^4.0.4",
    "seedrandom": "^3.0.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.1",
    "@cloudflare/workers-types": "^5.20260817.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/seedrandom": "^3.0.8",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "wrangler": "^4.123.0"
  }
}
