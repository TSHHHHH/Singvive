{
  "enabled": true,
  "name": "Lint on Save",
  "description": "Runs oxlint whenever a TypeScript or TSX file is saved, catching lint errors immediately.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*.ts",
      "**/*.tsx"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "npx oxlint"
  }
}